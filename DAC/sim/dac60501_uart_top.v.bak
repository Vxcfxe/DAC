`timescale 1ns/1ps
module dac60501_uart_top (
    input  wire clk,          // 50 MHz
    input  wire reset_n,      // active low

    input  wire uart_rx,

    output reg  dac_sdin,
    output reg  dac_sclk,
    output reg  dac_sync_n
);

    // ============================================================
    // 1. UART RX
    //
    // 50 MHz / 115200 = 434.027
    // ============================================================

    localparam integer CLKS_PER_BIT = 434;
    localparam integer HALF_BIT     = 217;

    reg [8:0] uart_clk_cnt;
    reg [3:0] uart_bit_cnt;

    reg uart_rx_ff1;
    reg uart_rx_ff2;
    reg uart_rx_busy;

    reg [7:0] uart_data;
    reg       uart_byte_valid;

    always @(posedge clk or negedge reset_n) begin

        if (!reset_n) begin

            uart_clk_cnt    <= 0;
            uart_bit_cnt    <= 0;
            uart_rx_ff1     <= 1'b1;
            uart_rx_ff2     <= 1'b1;
            uart_rx_busy    <= 1'b0;
            uart_data       <= 8'h00;
            uart_byte_valid <= 1'b0;

        end
        else begin

            // ----------------------------------------------------
            // UART input synchronizer
            // ----------------------------------------------------

            uart_rx_ff1 <= uart_rx;
            uart_rx_ff2 <= uart_rx_ff1;
            uart_byte_valid <= 1'b0;

            // ----------------------------------------------------
            // Waiting for start bit
            // ----------------------------------------------------

            if (!uart_rx_busy) begin

                if (uart_rx_ff2 == 1'b0) begin

                    uart_rx_busy <= 1'b1;

                    // half bit to middle of start bit
                    uart_clk_cnt <= HALF_BIT;

                    uart_bit_cnt <= 0;

                end

            end

            // ----------------------------------------------------
            // Receiving byte
            // ----------------------------------------------------

            else begin

                if (uart_clk_cnt > 0) begin

                    uart_clk_cnt <= uart_clk_cnt - 1;

                end
                else begin

                    uart_clk_cnt <= CLKS_PER_BIT - 1;

                    // bit 0~7 = data
                    if (uart_bit_cnt < 8) begin

                        uart_data[uart_bit_cnt] <= uart_rx_ff2;

                        uart_bit_cnt <= uart_bit_cnt + 1;

                    end

                    // bit 8 = stop bit
                    else begin

                        uart_rx_busy    <= 1'b0;
                        uart_byte_valid <= 1'b1;

                    end

                end

            end

        end

    end


    // ============================================================
    // 2. ASCII decimal parser
    //
    // PC发送：
    //
    //     1<CR>
    //     12<CR>
    //     100<CR>
    //     399<CR>
    //
    // 分别得到：
    //
    //     target_mv = 1
    //     target_mv = 12
    //     target_mv = 100
    //     target_mv = 399
    //
    // 采用逐位累加：
    //
    //     value_new = value_old * 10 + digit
    //
    // 因此不再区分 hundreds / tens / ones。
    // ============================================================

    reg [9:0] target_mv;

    // 当前正在接收的十进制数字
    reg [9:0] decimal_value;

    // 已经接收到至少一个数字
    reg       digit_valid;

    // 当前一条命令是否完成
    reg       command_ready;

    // ------------------------------------------------------------
    // 临时变量：
    //
    // 用于计算：
    //
    //     decimal_value * 10 + digit
    //
    // 1023以内足够覆盖本设计
    // ------------------------------------------------------------

    reg [13:0] decimal_value_next;

    always @(posedge clk or negedge reset_n) begin

        if (!reset_n) begin

            target_mv      <= 10'd0;
            decimal_value  <= 10'd0;
            digit_valid    <= 1'b0;
            command_ready  <= 1'b0;

        end
        else begin

            command_ready <= 1'b0;

            if (uart_byte_valid) begin

                // =================================================
                // ASCII '0' ~ '9'
                // =================================================

                if ((uart_data >= 8'h30) &&
                    (uart_data <= 8'h39)) begin

                    // ------------------------------------------------
                    // value * 10 + digit
                    //
                    // value*10 =
                    //     value*8 + value*2
                    // ------------------------------------------------

                    decimal_value_next =
                        (decimal_value << 3) +
                        (decimal_value << 1) +
                        (uart_data - 8'h30);

                    // ------------------------------------------------
                    // 防止 decimal_value 超过 999
                    //
                    // 实际DAC最多只需要399 mV，
                    // 所以后面还会再次进行 DAC code 饱和限制。
                    // ------------------------------------------------

                    if (decimal_value_next > 14'd999) begin

                        decimal_value <= 10'd999;

                    end
                    else begin

                        decimal_value <= decimal_value_next[9:0];

                    end

                    digit_valid <= 1'b1;

                end

                // =================================================
                // CR = 0x0D
                // =================================================

                else if (uart_data == 8'h0D) begin

                    if (digit_valid) begin

                        target_mv <= decimal_value;

                        command_ready <= 1'b1;
                    end

                    // 准备接收下一条命令
                    decimal_value <= 10'd0;
                    digit_valid   <= 1'b0;

                end

                // =================================================
                // LF = 0x0A
                //
                // 允许电脑发送：
                //
                //     100\r
                // 或
                //     100\r\n
                //
                // 收到LF时不再重复执行命令。
                // =================================================

                else if (uart_data == 8'h0A) begin

                    // 什么都不做

                end

            end

        end

    end


    // ============================================================
    // 3. mV -> DAC Code
    //
    // 模拟电路：
    //
    //       DAC
    //        |
    //       5.36k
    //        |
    //        +---- VOUT
    //        |
    //       1.02k
    //        |
    //       GND
    //
    // 分压比例：
    //
    //       1.02 / (5.36 + 1.02)
    //       ≈ 0.159875
    //
    // DAC满量程约2.5 V
    //
    // VOUT_MAX ≈ 399.7 mV
    //
    // 因此：
    //
    //       DAC_CODE ≈ target_mv * 4096 / 399.7
    //
    // 近似：
    //
    //       4096 / 399.7 ≈ 10.257
    //
    // 使用：
    //
    //       10 + 1/4 + 1/128
    //
    // 即：
    //
    //       code = mv*10 + mv/4 + mv/128
    // ============================================================

    reg [12:0] dac_code;

    wire [12:0] mv_times_10;
    wire [12:0] mv_div_4;
    wire [12:0] mv_div_128;

    assign mv_times_10 =
            (target_mv << 3) +
            (target_mv << 1);

    assign mv_div_4 =
            target_mv >> 2;

    assign mv_div_128 =
            target_mv >> 7;

    wire [13:0] dac_code_calc;

    assign dac_code_calc =
            mv_times_10 +
            mv_div_4 +
            mv_div_128;


    // ============================================================
    // 4. DAC Code 饱和限制
    //
    // 这是本次修复超量程回绕的关键。
    //
    // 如果：
    //
    //     dac_code_calc <= 4095
    //
    // 正常输出。
    //
    // 如果：
    //
    //     dac_code_calc > 4095
    //
    // 强制输出4095。
    //
    // 这样：
    //
    //     400 mV
    //     500 mV
    //     999 mV
    //
    // 都不会发生12 bit回绕。
    // ============================================================

    wire [11:0] dac_code_limited;

    assign dac_code_limited =
            (dac_code_calc > 14'd4095) ?
            12'd4095 :
            dac_code_calc[11:0];


    // ============================================================
    // 5. SPI controller
    //
    // SPI frame:
    //
    //     [8-bit address][16-bit data]
    //
    // 例如：
    //
    //     08 40 00
    //
    // DAC60501：
    //
    //     12-bit DAC code放在16-bit data的[15:4]
    //
    // 因此：
    //
    //     SPI_DATA = DAC_CODE << 4
    // ============================================================

    reg [23:0] spi_shift_reg;

    reg [5:0] spi_bit_count;

    reg [7:0] spi_div_counter;

    reg spi_busy;

    reg [2:0] spi_state;

    localparam SPI_IDLE   = 3'd0;
    localparam SPI_START  = 3'd1;
    localparam SPI_LOW    = 3'd2;
    localparam SPI_HIGH   = 3'd3;
    localparam SPI_FINISH = 3'd4;

    // ============================================================
    // SPI clock
    //
    // 50 MHz / (2*25) = 1 MHz
    // ============================================================

    localparam SPI_DIV = 25;


    // ============================================================
    // 6. Power-on initialization
    //
    // 等待约1 ms，然后：
    //
    //     04 00 00   GAIN
    //     03 00 00   CONFIG
    //     08 00 00   DAC = 0
    // ============================================================

    reg [15:0] power_counter;

    reg [2:0] init_state;

    localparam INIT_WAIT   = 3'd0;
    localparam INIT_GAIN   = 3'd1;
    localparam INIT_CONFIG = 3'd2;
    localparam INIT_ZERO   = 3'd3;
    localparam INIT_DONE   = 3'd4;

    reg init_done;


    // ============================================================
    // 7. SPI request
    // ============================================================

    reg spi_request;

    reg [23:0] spi_request_data;


    // ============================================================
    // 8. Main controller
    // ============================================================

    always @(posedge clk or negedge reset_n) begin

        if (!reset_n) begin

            power_counter <= 0;

            init_state <= INIT_WAIT;
            init_done  <= 1'b0;

            spi_request      <= 1'b0;
            spi_request_data <= 24'h000000;

            dac_code <= 13'd0;

            dac_sdin  <= 1'b0;
            dac_sclk  <= 1'b0;
            dac_sync_n <= 1'b1;

            spi_shift_reg  <= 24'd0;
            spi_bit_count  <= 6'd0;
            spi_div_counter <= 8'd0;

            spi_busy  <= 1'b0;
            spi_state <= SPI_IDLE;

        end

        else begin

            // ====================================================
            // Power-on initialization
            // ====================================================

            case (init_state)

                // ------------------------------------------------
                // Wait approximately 1 ms
                // ------------------------------------------------

                INIT_WAIT: begin

                    if (power_counter < 16'd50000) begin

                        power_counter <= power_counter + 1;

                    end
                    else begin

                        init_state <= INIT_GAIN;

                    end

                end


                // ------------------------------------------------
                // GAIN
                // ------------------------------------------------

                INIT_GAIN: begin

                    if (!spi_busy && !spi_request) begin

                        spi_request_data <= 24'h040000;

                        spi_request <= 1'b1;

                        init_state <= INIT_CONFIG;

                    end

                end


                // ------------------------------------------------
                // CONFIG
                // ------------------------------------------------

                INIT_CONFIG: begin

                    if (!spi_busy && !spi_request) begin

                        spi_request_data <= 24'h030000;

                        spi_request <= 1'b1;

                        init_state <= INIT_ZERO;

                    end

                end


                // ------------------------------------------------
                // DAC = 0
                // ------------------------------------------------

                INIT_ZERO: begin

                    if (!spi_busy && !spi_request) begin

                        spi_request_data <= 24'h080000;

                        spi_request <= 1'b1;

                        init_state <= INIT_DONE;

                    end

                end


                // ------------------------------------------------
                // Initialization finished
                // ------------------------------------------------

                INIT_DONE: begin

                    if (!spi_busy && !spi_request) begin

                        init_done <= 1'b1;

                    end

                end

            endcase


            // ====================================================
            // New UART command
            //
            // command_ready表示上一周期UART parser已经完成
            // target_mv也已经更新。
            //
            // 所以这里直接使用target_mv计算DAC。
            // ====================================================

            if (init_done && command_ready) begin

                // ------------------------------------------------
                // 保存经过限制后的DAC code
                // ------------------------------------------------

                if (dac_code_calc > 14'd4095) begin

                    dac_code <= 13'd4095;

                end
                else begin

                    dac_code <= dac_code_calc[12:0];

                end

                // ------------------------------------------------
                // DAC60501:
                //
                // 12-bit data occupies [15:4]
                //
                // DAC code << 4
                //
                // 关键：
                //
                // 这里必须使用 dac_code_limited，
                // 不能再直接使用 dac_code_calc。
                // ------------------------------------------------

                spi_request_data <=
                    {8'h08,
                     dac_code_limited,
                     4'b0000};

                spi_request <= 1'b1;

            end


            // ====================================================
            // SPI request accepted
            // ====================================================

            if (spi_request && !spi_busy) begin

                spi_request <= 1'b0;

                spi_busy <= 1'b1;

                spi_state <= SPI_START;

                spi_shift_reg <= spi_request_data;

                spi_bit_count <= 0;

                spi_div_counter <= 0;

                dac_sync_n <= 1'b0;

                dac_sclk <= 1'b0;

                dac_sdin <= spi_request_data[23];

            end


            // ====================================================
            // SPI transmission
            // ====================================================

            if (spi_busy) begin

                case (spi_state)

                    // ------------------------------------------------
                    // SPI_START
                    // ------------------------------------------------

                    SPI_START: begin

                        if (spi_div_counter < SPI_DIV-1) begin

                            spi_div_counter <= spi_div_counter + 1;

                        end
                        else begin

                            spi_div_counter <= 0;

                            spi_state <= SPI_HIGH;

                            dac_sclk <= 1'b1;

                        end

                    end


                    // ------------------------------------------------
                    // SPI_HIGH
                    // ------------------------------------------------

                    SPI_HIGH: begin

                        if (spi_div_counter < SPI_DIV-1) begin

                            spi_div_counter <= spi_div_counter + 1;

                        end
                        else begin

                            spi_div_counter <= 0;

                            // falling edge
                            dac_sclk <= 1'b0;

                            if (spi_bit_count == 23) begin

                                spi_state <= SPI_FINISH;

                            end
                            else begin

                                spi_bit_count <= spi_bit_count + 1;

                                spi_shift_reg <=
                                    {spi_shift_reg[22:0], 1'b0};

                                // next bit
                                dac_sdin <= spi_shift_reg[22];

                                spi_state <= SPI_START;

                            end

                        end

                    end


                    // ------------------------------------------------
                    // SPI_FINISH
                    // ------------------------------------------------

                    SPI_FINISH: begin

                        if (spi_div_counter < SPI_DIV-1) begin

                            spi_div_counter <= spi_div_counter + 1;

                        end
                        else begin

                            spi_div_counter <= 0;

                            dac_sync_n <= 1'b1;

                            dac_sclk <= 1'b0;

                            dac_sdin <= 1'b0;

                            spi_busy <= 1'b0;

                            spi_state <= SPI_IDLE;

                        end

                    end


                    // ------------------------------------------------
                    // Default
                    // ------------------------------------------------

                    default: begin

                        spi_busy <= 1'b0;

                        spi_state <= SPI_IDLE;

                    end

                endcase

            end

        end

    end

endmodule